[Unit]
Description=onebox-faas imaged — image/snapshot orchestrator (spec §4.6, ADR-003, ADR-005)
Documentation=https://docs.gregale.dev/ops/imaged
After=network.target faas-cp.slice faas-vmmd.service
Wants=faas-cp.slice faas-vmmd.service

[Service]
Type=simple
User=faas-imaged
Group=faas
# Binary is shipped by cd-controlplane.yml "Install binaries"
# step (line 278: `install -m 0755 ... /opt/faas/bin/<bin>`).
ExecStart=/opt/faas/bin/imaged --config /etc/faas/imaged.toml
Restart=on-failure
RestartSec=2s

# imaged owns OCI pulls + app-layer ext4 build (mkfs.ext4 -d inside the
# shared exec runner, ADR-003). 1 GB is enough for image-decompression
# spikes; cp.slice enforces the 6 GB total.
Slice=faas-cp.slice
MemoryMax=1G

EnvironmentFile=/etc/faas/sealed.env
# Staging root for the parent-ref overlay (ADR-053). /dev/shm is
# tmpfs on the EX44 box; the kernel rejects overlay mounts whose
# upper fs doesn't support tmpfile (the regression that broke every
# cd-controlplane deploy 2026-08-04 → 2026-08-05). Imaged creates
# the dir lazily on first call. Must be writable by faas-imaged —
# the path is covered by ReadWritePaths below.
Environment=FAAS_BASE_STAGING_ROOT=/dev/shm/faas-base-staging

# imaged → vmmd parent-ref overlay mount (ADR-075 / DEPLOY-1) is now
# an RPC: pkg/imaged/vmmclient.go calls MountOverlayParent on the
# vmmdgrpc unix socket, vmmd (the only root component per spec §11
# + CLAUDE.md) does the mount under cap_sys_admin. imaged no longer
# needs the cap locally — drop AmbientCapabilities= AND shrink the
# bounding set so the runtimecheck (cmd/imaged/caps.go) passes with
# Deny: cap_sys_admin. PR-F added AmbientCapabilities=cap_sys_admin
# because the original mount_overlay_linux.go syscall lived on the
# imaged side; DEPLOY-1 erases that path entirely, so the cap is
# now wrong and the runtimecheck would (correctly) fire on boot if
# it ever silently re-appeared.
#
# The CapabilityBoundingSet below covers everything imaged legitimately
# needs (no cap_sys_admin): setuid/setgid for the OCI pull user-ns
# dance, dac_override for the parent staging tree, kill for SIGTERM
# on the imaged process itself, sys_chroot if builderd ever mounts
# inside a chroot path (none today but the cap is harmless). sys_admin
# is the load-bearing omission — that's the architectural boundary.
CapabilityBoundingSet=cap_chown cap_dac_override cap_fowner cap_fsetid cap_kill cap_setgid cap_setuid cap_setpcap cap_net_bind_service cap_sys_chroot

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
# ProtectSystem=strict makes everything read-only except these. imaged writes:
#   /srv/fc/snap                          — snapshots
#   /srv/fc/base                          — base ext4 images (staged at startup, EnsureBaseExt4)
#   /srv/fc/sigs                          — ADR-038 build attestations, written as sigs/<key>.sig
#                                          under FAAS_STORAGE_ROOT by the cosign signer
#   /dev/shm/faas-base-staging            — overlayfs upper+work+merged for the parent-ref path.
#                                          tmpfs is required: kernel rejects overlay mounts whose
#                                          upper fs doesn't support tmpfile ("upper fs does not
#                                          support tmpfile"). Host /tmp is ext4 on cd-controlplane
#                                          EX44; without this path the parent-ref branch
#                                          crash-loops imaged at every EnsureBaseExt4 (the regression
#                                          that broke every cd-controlplane deploy 2026-08-04 →
#                                          2026-08-05). MkdirAll'd with 0755 on first start.
# A path missing here does not fail at startup — it fails later, mid-build,
# as "mkdir /srv/fc/<dir>: read-only file system", which reads like a disk
# fault rather than a unit-file gap. /srv/fc/sigs was missed when ADR-038
# landed and crash-looped imaged on the DO box.
ReadWritePaths=/srv/fc/snap /srv/fc/base /srv/fc/sigs /var/log/faas /var/spool/faas /dev/shm/faas-base-staging

[Install]
WantedBy=multi-user.target
