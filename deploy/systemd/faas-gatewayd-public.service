[Unit]
Description=onebox-faas gatewayd-public — plain-HTTP edge (Tier A7 split, ADR-070; TLS terminates at Caddy upstream)
Documentation=https://docs.gregale.dev/ops/gatewayd-public
# gatewayd-public depends on apid (route cache mirror subscribes to
# app_changed / domain_changed pg_notify) and gatewayd-internal (the
# unix-socket target we forward every inbound request to). Internal
# must be ready before the public daemon can pass /readyz itself.
After=faas-cp.slice network-online.target faas-apid.service faas-gatewayd-internal.service
Wants=faas-cp.slice faas-apid.service faas-gatewayd-internal.service

[Service]
Type=simple
# Binary is shipped by cd-controlplane.yml "Install binaries"
# step (line 278: `install -m 0755 ... /opt/faas/bin/<bin>`).
ExecStart=/opt/faas/bin/gatewayd-public
Restart=on-failure
RestartSec=2s

# Hard ceiling from the control-plane budget (spec §13: 512M for
# gatewayd). gatewayd-public is smaller than the legacy gatewayd
# (no wake gate, no forwarder, no per-process buckets, no certmagic)
# so 256M is honest; the legacy value is kept as a safety ceiling in
# case a later PR adds the rate-limit read-through cache here.
Slice=faas-cp.slice
MemoryMax=512M

# Public listener: plain HTTP on 127.0.0.1:8080 behind Caddy upstream
# (api.gregale.dev). No low-port bind, no TLS termination in this
# daemon — CAP_NET_BIND_SERVICE is therefore unused.
AmbientCapabilities=

# Control listener (PR-J / 2026-08-05). The default control_addr
# (127.0.0.1:9090) is the SAME port gatewayd-internal binds for its
# control plane. Both daemons were launched with that default
# (gatewayd-public ran without --config; gatewayd-internal's
# /etc/faas/gatewayd-internal.toml was never shipped by
# cd-controlplane.yml). They fought for :9090 every restart cycle,
# the loser dying with `bind: address already in use` and taking the
# egress listener fd with it via the stop() defer — meterd then
# log-flooded from the missing /run/faas/gatewayd-egress.sock and
# OOM-killed (run 31121004495, run 30987332162 post-#639).
#
# Pick a port the rest of the platform doesn't claim: apid control is
# :9101, schedd control is :9091, prometheus-node-exporter is :9100,
# prometheus is :9095, leaving :9092 free for gatewayd-public's
# control. Read by cmd/gatewayd-public/main.go:154 (envOr("FAAS_PUBLIC_CONTROL_ADDR")).
Environment=FAAS_PUBLIC_CONTROL_ADDR=127.0.0.1:9092

# Hardening baseline — gatewayd-public is NOT root; runs as faas:faas.
User=faas
Group=faas

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# gatewayd-public dials gatewayd-internal.sock (AF_UNIX) and accepts
# Caddy's reverse-proxy on 127.0.0.1:8080 (AF_INET). It does NOT make
# outbound HTTP — the reverse-proxy is inbound-only. AF_INET6 dropped
# because the bind is loopback v4.
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible

# Plain-HTTP mode: no certmagic storage. /run/faas is owned by
# faas-vmmd.service (the SOLE RuntimeDirectory=faas across the faas
# service set). The public daemon dials gatewayd-internal.sock,
# which lives in the host /run/faas (vmmd's bind-mount) — so we
# need ReadWritePaths=/run/faas. Declaring RuntimeDirectory=faas
# here would just create a second per-unit tmpfs whose bind-mount
# wouldn't propagate back to /run.
ReadWritePaths=/run/faas
ReadOnlyPaths=/etc/faas

[Install]
WantedBy=multi-user.target