[Unit]
Description=onebox-faas apid — public control-plane API (spec §4.1)
Documentation=https://docs.DOMAIN/ops/apid
After=network.target faas-cp.slice
Wants=faas-cp.slice

[Service]
Type=simple
User=faas-apid
Group=faas
ExecStart=/usr/local/bin/apid --config /etc/faas/apid.toml
Restart=on-failure
RestartSec=2s

# apid lives inside the control-plane budget (spec §13 line 431). The 256M
# ceiling covers Postgres connection + JSON marshalling bursts; the cp.slice
# itself enforces the 6 GB total.
Slice=faas-cp.slice
MemoryMax=256M

# apid binds ONLY loopback (127.0.0.1:8081) — gatewayd is the only public
# listener (spec §11 single-public-listener invariant). The cap is left in
# place because apid's tests boot a dev listener on :80 on some Macs and
# we want the prod unit to survive that dev cycle unchanged.
AmbientCapabilities=CAP_NET_BIND_SERVICE

# DATABASE_URL carries the Postgres DSN; secrets live in /etc/faas/sealed.env
# (gap G2 — sealed at rest, dec only by systemd EnvironmentFile).
EnvironmentFile=/etc/faas/sealed.env

# Session signing key (security review A4). LoadCredential surfaces
# /etc/faas/secrets/session.key inside the unit's credentials dir;
# Environment reads it back into FAAS_SESSION_KEY so apid's existing
# os.Getenv("FAAS_SESSION_KEY") loader path is unchanged. This keeps
# the key out of /etc/faas/sealed.env — every other control-plane
# daemon reads sealed.env but does NOT read this credential, so the
# 32-byte key never enters their environment.
LoadCredential=faas_session_key:/etc/faas/secrets/session.key
Environment=FAAS_SESSION_KEY=%d/faas_session_key
# Host age identity (IAM-2 / issue #186). apid reads the private
# half of the host X25519 key to unseal TOTP secrets during
# /verify + /confirm + /recover + /disable. The on-disk file is
# /etc/faas/secrets/host.age, mode 0400 root:root (spec §11, per
# pkg/secretbox/hostkey.go:138 GenerateAndSaveHostKey); apid does
# NOT open the on-disk file directly — systemd copies it into the
# unit's credential dir (owned by faas-apid:faas) under the
# %d/faas_host_age_identity path. Without this env var the MFA
# handlers 503 CodeCapacity and every mfa_pending session locks
# the customer out indefinitely.
LoadCredential=faas_host_age_identity:/etc/faas/secrets/host.age
Environment=FAAS_HOST_AGE_IDENTITY_PATH=%d/faas_host_age_identity

# Hardening baseline.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
ReadWritePaths=/var/log/faas /var/spool/faas

[Install]
WantedBy=multi-user.target
