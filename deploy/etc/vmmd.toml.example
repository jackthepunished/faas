# Example vmmd config — copy to /etc/faas/vmmd.toml on the box.
# Every field is optional; defaults are filled in by LoadConfig (see
# cmd/vmmd/config.go). Defaults are noted next to each field.

# socket_path: unix-domain socket path. Mode 0660, group 'faas' (ADR-015).
# Default: /run/faas/vmmd.sock
# socket_path = "/run/faas/vmmd.sock"

# metrics_addr: optional bind address for /metrics. Empty disables metrics.
# Default: "" (no metrics endpoint)
# metrics_addr = "127.0.0.1:9090"

# owner_user: the unix user that owns the unix-domain socket file. Members
# of the 'faas' group can dial the socket. Default: faas-vmmd
# owner_user = "faas-vmmd"

# kernel_path: path to the Firecracker-compatible kernel image. The daemon
# refuses to start if this file is missing. Default: /srv/fc/base/vmlinux-6.1
# kernel_path = "/srv/fc/base/vmlinux-6.1"

# --- Issue #95 / ADR-025: location-transparent gRPC transport ---
# vmmd can serve over TCP for the decoupled compute layout (vmmd on a
# dedicated KVM host, control plane elsewhere). All five spec invariants
# and §11 ship-blockers are unchanged.

# listen_addr: gRPC listen target (the address vmmd BINDS to).
# Empty (default) keeps the legacy unix://+socket_path behavior.
# Set to "tcp://0.0.0.0:50051" only when the control plane and vmmd
# live on different hosts. A tcp target requires all three
# tls_*_path fields to be set or startup fails closed.
# Default: "" (unix socket)
# listen_addr = "tcp://0.0.0.0:50051"

# IMPORTANT: listen_addr is the BIND address, NOT the dial target.
# On a multi-box fleet schedd/gatewayd dial a separate routable
# FQDN/IP to reach this vmmd; that dial target goes in
# [compute_node].target_url below (NOT in listen_addr). Setting
# listen_addr to a routable FQDN works for single-box dev but
# leaves the operator's target_url unset — vmmd logs a Warn at
# startup if it detects the two are equal AND tcp://. See
# docs/runbooks/multi-host-rollout.md §3.5.

# tls_cert_path / tls_key_path / tls_ca_path: server-mTLS cluster.
# All three empty => no TLS (single-box loopback UNIX path). All three
# set => RequireAndVerifyClientCert over TLS 1.3 with ALPN h2.
# Partial cluster => startup error naming the missing fields.
# Defaults: ""
# tls_cert_path = "/etc/faas/tls/vmmd.crt"
# tls_key_path = "/etc/faas/tls/vmmd.key"
# tls_ca_path = "/etc/faas/tls/ca.pem"

# --- [compute_node] block: vmmd self-registration (issue #98 / ADR-028) ---

# name: operator-facing compute_nodes.name. Empty (default) skips
# self-registration entirely — the daemon serves traffic but schedd
# only routes via default-local (migration 00024). Multi-box boxes
# MUST set this to a non-empty name (e.g. "fsn-2").
# Default: ""
# [compute_node]
# name = "fsn-2"

# target_url: the DIAL target schedd/gatewayd use to reach this
# vmmd (the value written to compute_nodes.target_url on
# self-registration). This is the field that gets clobbered if
# left empty AND listen_addr is set to a tcp:// form — set this
# explicitly to a routable FQDN (e.g. "tcp://vmmd-2.faas:50051").
# Optional: when empty, ResolveTargetURL falls back to
# `tcp://`+overlay_ip+`:50051` if overlay_ip is set, otherwise to
# the unix socket path. See docs/runbooks/multi-host-rollout.md §3.5.
# Default: ""
# target_url = "tcp://vmmd-2.faas:50051"

# overlay_ip: Tailscale/Wireguard IP this box advertises on the
# cross-host mesh. Auto-detected at startup via `tailscale ip -4`
# when empty. Set explicitly on air-gapped or non-tailscale fleets.
# Default: "" (auto-detect)
# overlay_ip = "100.64.0.1"

# vpcpus: total vCPUs this box offers. Schedd's per-node vCPU
# admission gate (Tier A2, migration 00123) reads this value.
# Default: 160
# vpcpus = 160

# mem_mb: total RAM in MiB.
# Default: 56000
# mem_mb = 56000

# max_concurrency: parallel live instances the box can hold.
# Default: 200
# max_concurrency = 200

# admission_ceiling_mb: Σ(ram_mb + 8) cap — the invariant 2 floor.
# Default: 47600 (api.DefaultComputeNodeCeilingMB)
# admission_ceiling_mb = 47600

# tls_cert_path / tls_key_path / tls_ca_path: server-mTLS cluster.
# All three empty => no TLS (single-box loopback UNIX path). All three
# set => RequireAndVerifyClientCert over TLS 1.3 with ALPN h2.
# Partial cluster => startup error naming the missing fields.
# Defaults: ""
# tls_cert_path = "/etc/faas/tls/vmmd.crt"
# tls_key_path = "/etc/faas/tls/vmmd.key"
# tls_ca_path = "/etc/faas/tls/ca.pem"
