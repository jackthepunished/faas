[Service]
# Mega-PR-A (issue #911 / ADR-110 PR-1): expose this box's
# compute_node identity to builderd so the build_claimed log lines
# carry the canonical host name. Empty FAAS_NODE_NAME falls through
# to the short-hostname default — builderd's main.go reads the env
# var on first dial to label build_artifact rows in the
# deployments + build_runs tables.
#
# Mirrors deploy/ansible/roles/control_plane_service/templates/
# 99-faas-node-name.conf.j2 — body is identical across roles.
Environment=FAAS_NODE_NAME={{ faas_node_name }}
