[Unit]
Description=onebox-faas builderd — build orchestrator + ephemeral builder microVMs (spec §4.5, ADR-003, ADR-005)
Documentation=https://docs.gregale.dev/ops/builderd
After=network.target faas-cp.slice faas-vmmd.service faas-apid.service
Wants=faas-cp.slice faas-vmmd.service faas-apid.service

[Service]
Type=simple
# builderd is a non-root daemon (mirror imaged's User=/Group=). KVM
# access is not direct — builderd's ephemeral VMs are spawned through
# vmmd (ADR-003), so no /dev/kvm from this unit. The user identity
# matches the daemonunit constructor for builderd
# (pkg/daemonunitspec/builderd.go).
User=faas-builderd
Group=faas
# builderd reads FAAS_BUILDERD_CONFIG env var (cmd/builderd/main.go:66)
# — no --config flag. /etc/faas/sealed.env is the canonical source the
# env-var falls back to when the drop-in (set by the Mega-PR-C tasks)
# does not override.
ExecStart=/opt/faas/current/bin/builderd
Restart=on-failure
RestartSec=2s

Slice=faas-cp.slice
MemoryMax=512M

# ADR-003 + ADR-005 — builds run inside ephemeral builder microVMs
# (never host containers, never buildkit). The microVM boundary IS
# the resource cap and the sandbox. The /srv/fc/builder dir is the
# staging root for the build artifact; ReadWritePaths= below
# whitelists exactly the paths the daemon writes to.
# FAAS_BUILDERD_CONFIG set via EnvironmentFile=/etc/faas/sealed.env;
# FAAS_BUILDERD_ROLE set via the 99-faas-role.conf drop-in (Mega-PR-C).
# Sealed env is the production source for optional overrides; the TOML
# config remains sufficient for an image-seeded compute node. A missing
# sealed file must not turn the role-correct builder daemon into a systemd
# 203/resources loop during first boot.
EnvironmentFile=-/etc/faas/sealed.env
EnvironmentFile=-/etc/faas/compute-db.env

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
ReadWritePaths=/srv/fc/builder /srv/fc/base /var/log/faas /var/spool/faas /var/lib/faas/cache

[Install]
WantedBy=multi-user.target
