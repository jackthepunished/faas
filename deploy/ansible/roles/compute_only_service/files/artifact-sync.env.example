# Optional only when this compute box uses FAAS_STORAGE_BACKEND=local and
# schedd verifies artifacts from a separate control-plane filesystem.
# Prefer FAAS_STORAGE_BACKEND=oci for a public multi-node deployment.
FAAS_ARTIFACT_REPLICATOR=/usr/local/libexec/faas-artifact-replicator
FAAS_ARTIFACT_SYNC_TARGET=control-plane.internal
FAAS_ARTIFACT_SYNC_USER=root
# FAAS_ARTIFACT_SYNC_SSH_KEY=/root/.ssh/id_rsa
# FAAS_ARTIFACT_SYNC_APPS_ROOT=/var/lib/faas/apps
# FAAS_ARTIFACT_SYNC_STORAGE_ROOT=/srv/fc
