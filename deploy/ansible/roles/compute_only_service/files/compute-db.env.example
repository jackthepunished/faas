# Root-owned runtime credentials for compute-only daemons.
# Copy to /etc/faas/compute-db.env, set mode 0600, and provision the
# values from the operator's secret store. Keep the full DSN quoted so
# systemd's EnvironmentFile parser does not reinterpret credential bytes.
DATABASE_URL='postgres://faas:<password>@<control-plane-address>:5432/faas?sslmode=disable'
FAAS_VMMD_DBURL='postgres://faas:<password>@<control-plane-address>:5432/faas?sslmode=disable'

# Split-node artifact contract. These values are mandatory on production
# compute-only hosts: every compute node must resolve snapshots, runtime
# bases, kernels, and app layers from the same shared OCI store. The literal
# `none` is intentional; leaving the local-prefix variable unset preserves
# the single-box defaults and is rejected by the strict startup gate.
FAAS_STORAGE_BACKEND=oci
FAAS_STORAGE_LOCAL_PREFIXES=none
FAAS_REQUIRE_SHARED_ARTIFACTS=1
FAAS_STORAGE_CACHE_SERVE_STALE=0
FAAS_OCI_REGISTRY=https://<registry-host>/<organization>
