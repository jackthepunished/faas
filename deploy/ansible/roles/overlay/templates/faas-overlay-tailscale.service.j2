[Unit]
Description=faas overlay (tailscale)
After=network-online.target
Wants=network-online.target
Requires=tailscaled.service
After=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=FAAS_OVERLAY_AUTHKEY_FILE={{ faas_overlay_authkey_path }}
# tailscale up reads the authkey from disk via --authkey=file:.
# The package-owned tailscaled.service supplies the long-running daemon;
# this unit only performs enrollment and therefore can safely be oneshot.
ExecStart=/usr/bin/tailscale up \
    --authkey=file:{{ faas_overlay_authkey_path }} \
    --hostname={{ faas_overlay_hostname }} \
    --accept-routes \
    --advertise-tags={{ faas_overlay_tags }}
ExecStop=/usr/bin/tailscale down

[Install]
WantedBy=multi-user.target
