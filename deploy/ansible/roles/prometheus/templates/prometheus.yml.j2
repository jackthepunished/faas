# Prometheus scrape config (spec §12 dashboard pipeline).
# Generated by ansible — do not hand-edit on the box.

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    box: "{{ ansible_hostname }}"

# Alert rules — evaluated every 30s against the closed (daemon, severity)
# label set declared in faas.rules.yml. Three severities map to receivers
# via the Alertmanager role (deploy/ansible/roles/alertmanager/):
#   info  → no notify (route suppressed)
#   warn  → ticket-only email
#   page  → operator email + Pushover
# See docs/runbooks/<AlertName>.md for triage steps per alert.
rule_files:
  - /etc/prometheus/faas.rules.yml
  # ADR-098 §9.A meterd data-upstream alerts (issue #951). The
  # prometheus role's tasks/main.yml drops this file from
  # pkg/promqlrules/data_placement.yaml — single source of truth,
  # colocated with the synthetic fixture + Go driver. If the file is
  # absent the alert is simply skipped (Prometheus tolerates a
  # missing rule_files entry).
  - /etc/prometheus/data_placement.yaml
  # Issue #250 — off-host Postgres backup alert (PgBackupStale). The
  # postgres_backup role drops this file; if it's absent the alert
  # is simply skipped (Prometheus tolerates a missing rule_files entry).
  - /etc/prometheus/pg_backup.rules.yml
  # ADR-127 §D3 / G19 — bridge wire-protocol framing alerts
  # (FaasBridgeFramingMismatch + FaasBridgeRollbackStuck). The
  # prometheus role drops this file at tasks/main.yml; if it's
  # absent the alerts are simply skipped (Prometheus tolerates a
  # missing rule_files entry). Runbook: docs/ops/h2c-rollback.md.
  - /etc/prometheus/bridge.rules.yml

# Alertmanager — loopback-only, dialed from the Prometheus binary on the
# same box. Wired here so the operator's pager sees what the dashboard
# will eventually show.
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["{{ prom_alertmanager_url | replace('http://','') | replace('https://','') }}"]

scrape_configs:
{% for tgt in prom_targets %}
  - job_name: "{{ tgt.job }}"
    static_configs:
      - targets: ["{{ tgt.host }}:{{ tgt.port }}"]
        labels:
          job: "{{ tgt.job }}"
{% if tgt.metrics_path is defined %}
    metrics_path: "{{ tgt.metrics_path }}"
{% endif %}
{% endfor %}
{% if (faas_box_role | default('')) == 'control-plane' %}
  # Compute gateway metrics are served on the compute data-plane listener
  # only for this private scrape path. The generated nftables policy permits
  # port 8080 from control-plane addresses; no provider-specific IP is
  # embedded here. faas_node_name is the stable /etc/hosts alias emitted by
  # the manifest resolver and works unchanged on GCP, Hetzner, and OVH.
{% for compute_host in groups['compute_nodes'] | default([]) %}
  - job_name: "gatewayd-internal-{{ compute_host }}"
    static_configs:
      - targets: ["{{ hostvars[compute_host].faas_node_name | default(compute_host) }}:8080"]
        labels:
          job: "gatewayd-internal"
          node: "{{ hostvars[compute_host].faas_node_name | default(compute_host) }}"
    metrics_path: "/metrics"
{% endfor %}
{% endif %}
