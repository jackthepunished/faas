# Example imaged config — copy to /etc/faas/imaged.toml on the box.

# log_level: slog level (debug, info, warn, error).
# Default: info
# log_level = "info"

# snapshot_root: where snapshot blobs live. The unit's ReadWritePaths grants
# imaged write access here. Keep this off /tmp (tmpfs eats RAM).
# Default: /srv/fc/snap
# snapshot_root = "/srv/fc/snap"

# db_url: Postgres DSN. Empty => $DATABASE_URL from the environment.
# db_url = ""

# Per-app cosign signature-enforcement (issue #472 / ADR-058).
# imaged reads this directory once at startup and on every
# pg_notify('trusted_signer_changed') event. Each .pem file is
# the base64-DER mirror of one (app_id, signer_name) row written
# by apid. imaged decodes the DER, parses the SPKI, and verifies
# the deploy-time signature against every loaded publisher until
# one matches. Mode 0444 per file (same posture as
# /etc/faas/secrets/sign-pub.pem). Default location if unset:
#
#   /etc/faas/secrets/trusted-publishers
#
# Set FAAS_TRUSTED_PUBLISHERS_DIR in /etc/faas/imaged.env (the
# systemd EnvironmentFile) to override. Missing directory is
# non-fatal — imaged returns an empty trust list and the apid
# pre-flight gate (handlers.go::createDeployment) rejects any
# deploy to an app with require_signed=true.
