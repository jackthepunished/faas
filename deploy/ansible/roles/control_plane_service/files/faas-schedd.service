[Unit]
Description=onebox-faas schedd — scheduler + lifecycle owner
After=network.target faas-cp.slice faas-brokerq.slice
Wants=faas-cp.slice faas-brokerq.slice

[Service]
Type=simple
User=faas-schedd
Group=faas
ExecStartPre=/usr/bin/install -d -o faas-schedd -g faas -m 0770 /var/lib/faas/oci-tmp
ExecStartPre=/opt/faas/current/bin/schedd-brokerq-apply
ExecStart=/opt/faas/current/bin/schedd --config /etc/faas/schedd.toml
Restart=on-failure
RestartSec=2s
# PR #1082 review-fix #2: surface the per-unit restart count to the
# daemon via $SYSTEMD_RESTARTS_ON_FAILURE (systemd 254+
# RestartCountExport). pkg/wire/daemon.go::Daemon() reads the env var
# at boot and records it on daemon_restart_count so the
# FaasRestartLoop / FaasRepeatedRestart / FaasStuckActivating alerts
# (ADR-128) have a real-time signal.
RestartCountExport=SYSTEMD_RESTARTS_ON_FAILURE
Slice=faas-cp.slice
MemoryMax=256M
EnvironmentFile=/etc/faas/sealed.env
Environment=TMPDIR=/var/lib/faas/oci-tmp
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
ReadWritePaths=/run/faas /var/lib/faas /var/log/faas

[Install]
WantedBy=multi-user.target
