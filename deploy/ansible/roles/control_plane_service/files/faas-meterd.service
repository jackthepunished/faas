[Unit]
Description=onebox-faas meterd — metering and billing
After=network.target postgresql.service faas-schedd.service faas-cp.slice
Wants=faas-cp.slice faas-schedd.service

[Service]
Type=simple
User=faas-meterd
Group=faas
ExecStart=/opt/faas/current/bin/meterd --config /etc/faas/meterd.toml
Restart=on-failure
RestartSec=2s
# PR #1082 review-fix #2: surface the per-unit restart count to the
# daemon via $SYSTEMD_RESTARTS_ON_FAILURE (systemd 254+
# RestartCountExport). pkg/wire/daemon.go::Daemon() reads the env var
# at boot and records it on daemon_restart_count so the
# FaasRestartLoop / FaasRepeatedRestart / FaasStuckActivating alerts
# (ADR-128) have a real-time signal.
RestartCountExport=SYSTEMD_RESTARTS_ON_FAILURE
Slice=faas-cp.slice
MemoryMax=256M
EnvironmentFile=/etc/faas/sealed.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
ReadWritePaths=/var/log/faas

[Install]
WantedBy=multi-user.target
