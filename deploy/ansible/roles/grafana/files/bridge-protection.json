        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(count by (app_protocol) (rate(vmmd_bridge_framing_total{bridge_protocol=\"h1\",app_protocol=~\"http2|grpc\"}[5m]) > 0))",
