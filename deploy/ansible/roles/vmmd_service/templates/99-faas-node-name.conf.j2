[Service]
# Mega-PR-A (issue #911 / ADR-110 PR-1): expose this box's compute_node
# identity to vmmd so the [compute_node].name self-registration
# (cmd/vmmd/register.go) writes the right row at startup. Empty
# FAAS_NODE_NAME falls through to the short-hostname default — the
# vmmd self-register path retains that back-compat.
#
# Mirrors deploy/ansible/roles/control_plane_service/templates/
# 99-faas-node-name.conf.j2 — body is identical across roles.
Environment=FAAS_NODE_NAME={{ faas_node_name }}
