[Unit]
Description=onebox-faas schedd — scheduler + lifecycle owner
After=network.target faas-cp.slice
Wants=faas-cp.slice

[Service]
Type=simple
User=faas-schedd
Group=faas
ExecStartPre=/usr/bin/install -d -o faas-schedd -g faas -m 0770 /var/lib/faas/oci-tmp
ExecStart=/opt/faas/current/bin/schedd --config /etc/faas/schedd.toml
Restart=on-failure
RestartSec=2s
Slice=faas-cp.slice
MemoryMax=256M
EnvironmentFile=/etc/faas/sealed.env
# /run is tmpfs; large OCI layers would count against this unit's 256M
# cgroup limit and can trigger an OOM kill. Keep verifier scratch on disk.
Environment=TMPDIR=/var/lib/faas/oci-tmp
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
ReadWritePaths=/run/faas /var/lib/faas /var/log/faas

[Install]
WantedBy=multi-user.target
