[Unit]
Description=onebox-faas schedd — scheduler + lifecycle owner
After=network.target postgresql.service faas-cp.slice
Wants=faas-cp.slice
Requires=postgresql.service

[Service]
Type=simple
User=faas-schedd
Group=faas
ExecStart=/opt/faas/bin/schedd --config /etc/faas/schedd.toml
Restart=on-failure
RestartSec=2s
Slice=faas-cp.slice
MemoryMax=256M
EnvironmentFile=/etc/faas/sealed.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# PrivateTmp=no + RuntimeDirectory=faas — see faas-vmmd.service for the
# reasoning. Without dropping PrivateTmp, schedd.sock lands inside
# schedd's per-mount-namespace tmpfs and imaged (which dials it) gets
# `no such file or directory` (run 30839233808).
PrivateTmp=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
ReadWritePaths=/run/faas /var/log/faas
RuntimeDirectory=faas
RuntimeDirectoryMode=0770

[Install]
WantedBy=multi-user.target
